# Copy to .env and fill in the values shared by NeoStats. Never commit .env.

# NeoStats-hosted LLM (OpenAI-compatible endpoint)
LLM_BASE_URL=https://<your-endpoint>/openai/v1/
LLM_API_KEY=<your-api-key>
LLM_MODEL=<deployment-name>
LLM_TIMEOUT_SECONDS=60
LLM_REASONING_EFFORT=medium
LLM_TEMPERATURE=0.2

# Local embedding model (FastEmbed). Replace if NeoStats provides an embedding model.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Paths
DB_PATH=Data/ridewise.db
INDEX_PATH=index

# strict = customer ID + registered mobile number as password (default); demo = customer ID only
AUTH_MODE=strict
